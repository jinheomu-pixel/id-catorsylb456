// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// IDCator - Imbalance Levels (clean-room replica of the order-flow tool shown in ProfitPro's videos; not their code)
//
// Stacked diagonal bid/ask imbalances of every closed bar become support (buy stack, below the close) and
// resistance (sell stack, above the close) zones. A zone extends to the current bar until price trades back into
// it, then it stops at that bar. Label: strongest ratio | stack volume ("6.7x | 350"). Darker = stronger.
// Needs TradingView volume footprint data (request.footprint: Premium or Ultimate plan). Not a buy/sell signal.
//@version=6
indicator("IDC Imbalance Levels", "IDC Imbalance", overlay = true, max_boxes_count = 500)

// ───────────────────────────────────────────── inputs
G_DET = "Detection"
int    rowTicksInput   = input.int(0, "Ticks per row (0 = auto)", minval = 0, group = G_DET,
     tooltip = "0 = auto: 1 tick on futures and stocks; on crypto and spot metals about 20 rows across a typical bar of this timeframe. The Data Window shows the value in use.")
float  minRatioInput   = input.float(5.0, "Min imbalance ratio", minval = 1.1, step = 0.5, group = G_DET,
     tooltip = "Diagonal comparison: buy volume at a price vs sell volume one row lower (and sell vs buy one row higher).")
int    minStackInput   = input.int(3, "Min stacked levels", minval = 1, group = G_DET)
float  minLevelVolInput = input.float(0, "Min volume per level", minval = 0, group = G_DET,
     tooltip = "A level only counts when its aggressive volume is at least this much.")
float  minStackVolInput = input.float(0, "Min stack volume", minval = 0, group = G_DET)
string zeroInput       = input.string("Count as min ratio", "Zero-value handling", options = ["Count as min ratio", "Count as 1", "Skip"], group = G_DET,
     tooltip = "What to do when the opposite diagonal level traded nothing. 'Count as min ratio' gives labels like '5x | 8' as in the videos.")
bool   beyondCloseInput = input.bool(true, "Buy stacks below close, sell stacks above", group = G_DET)
bool   discardNextInput = input.bool(false, "Discard if next bar touches", group = G_DET)

G_VIS = "Display"
color  supColorInput   = input.color(color.rgb(34, 171, 92), "Support (buy stack)", group = G_VIS)
color  resColorInput   = input.color(color.rgb(233, 57, 61), "Resistance (sell stack)", group = G_VIS)
int    minOpacInput    = input.int(8, "Opacity at min ratio %", minval = 1, maxval = 100, group = G_VIS)
int    maxOpacInput    = input.int(45, "Opacity at full ratio %", minval = 1, maxval = 100, group = G_VIS)
float  fullRatioInput  = input.float(15, "Full-opacity ratio", minval = 1.1, group = G_VIS)
bool   showLabelsInput = input.bool(true, "Show labels", group = G_VIS)
color  textColorInput  = input.color(color.rgb(224, 224, 224), "Label color", group = G_VIS)
int    textSizeInput   = input.int(9, "Label size (pt)", minval = 5, maxval = 30, group = G_VIS)
bool   keepTouchedInput = input.bool(true, "Keep touched zones", group = G_VIS)
bool   showLiveInput   = input.bool(true, "Show the forming bar's stacks (live, dashed)", group = G_VIS)
int    maxZonesInput   = input.int(300, "Max zones on chart", minval = 10, maxval = 500, group = G_VIS)

G_ALR = "Alerts"
bool   alertTouchInput = input.bool(true, "Alert when price touches a zone", group = G_ALR,
     tooltip = "Create an alert on this indicator with 'Any alert() function call'.")

// ───────────────────────────────────────────── data
// ───────────────────────────────────────────── footprint row size
// request.footprint() takes a "simple int" row size, fixed when the script loads. Pine treats the parameters of our own
// functions as "series", so the size is worked out here at the top level, from syminfo and timeframe only: plain
// expressions, no function of ours, no switch, if, loop or :=.
// Futures and stocks: 1 tick. Crypto and spot metals (their tick is tiny next to their price): about 20 rows across a
// typical bar of the chart's timeframe (daily range: 3 % crypto, 1.5 % metals).
string rowCoin      = syminfo.basecurrency
string rowQuote     = syminfo.currency
bool   rowInDollars = rowQuote == "USD" or rowQuote == "USDT" or rowQuote == "USDC" or rowQuote == "FDUSD" or rowQuote == "BUSD" or
     rowQuote == "USDE" or rowQuote == "DAI" or rowQuote == "TUSD" or rowQuote == "PYUSD" or rowQuote == "USD1" or rowQuote == "EUR" or rowQuote == "GBP"
string rowTicker    = syminfo.ticker
//@variable Rough dollar price of a coin or a spot metal, 0 when it is not listed. Only the order of magnitude matters:
// a price off by 2x moves the row size by one step. Spot metals are also known by their ticker (OANDA:XAUUSD and other
// broker symbols may carry no base currency).
float  rowListedPx  = rowTicker == "XAUUSD" or rowTicker == "GOLD" ? 4000.0 : rowTicker == "XAGUSD" or rowTicker == "SILVER" ? 50.0 :
     rowTicker == "XPTUSD" or rowTicker == "PLATINUM" ? 1500.0 : rowTicker == "XPDUSD" or rowTicker == "PALLADIUM" ? 1200.0 :
     not rowInDollars ? 0.0 :
     rowCoin == "BTC" or rowCoin == "WBTC" ? 100000.0 :
     rowCoin == "ETH" or rowCoin == "WETH" ? 3500.0 :
     rowCoin == "BNB" ? 700.0 :
     rowCoin == "SOL" ? 180.0 :
     rowCoin == "XRP" ? 2.5 :
     rowCoin == "DOGE" or rowCoin == "HBAR" ? 0.25 :
     rowCoin == "ADA" or rowCoin == "JUP" ? 0.8 :
     rowCoin == "TRX" or rowCoin == "ALGO" ? 0.3 :
     rowCoin == "AVAX" or rowCoin == "HYPE" ? 30.0 :
     rowCoin == "LINK" or rowCoin == "INJ" ? 20.0 :
     rowCoin == "DOT" or rowCoin == "ATOM" or rowCoin == "RENDER" ? 6.0 :
     rowCoin == "TON" or rowCoin == "NEAR" or rowCoin == "FIL" or rowCoin == "TIA" ? 4.0 :
     rowCoin == "SHIB" ? 0.000015 :
     rowCoin == "PEPE" ? 0.00001 :
     rowCoin == "BONK" ? 0.00002 :
     rowCoin == "FLOKI" ? 0.0001 :
     rowCoin == "LTC" ? 100.0 :
     rowCoin == "BCH" ? 450.0 :
     rowCoin == "XLM" ? 0.35 :
     rowCoin == "SUI" ? 3.5 :
     rowCoin == "APT" or rowCoin == "ICP" ? 8.0 :
     rowCoin == "UNI" or rowCoin == "TRUMP" ? 10.0 :
     rowCoin == "ETC" ? 22.0 :
     rowCoin == "ARB" or rowCoin == "CRV" or rowCoin == "ENA" ? 0.6 :
     rowCoin == "OP" or rowCoin == "WIF" or rowCoin == "STX" or rowCoin == "LDO" or rowCoin == "WLD" ? 1.5 :
     rowCoin == "AAVE" ? 250.0 :
     rowCoin == "MKR" ? 1500.0 :
     rowCoin == "SEI" ? 0.4 :
     rowCoin == "FET" or rowCoin == "IMX" ? 1.2 :
     rowCoin == "TAO" ? 400.0 :
     rowCoin == "XMR" ? 300.0 :
     rowCoin == "ZEC" ? 50.0 :
     rowCoin == "ONDO" ? 1.0 :
     rowCoin == "PENGU" ? 0.02 :
     rowCoin == "KAS" ? 0.1 :
     rowCoin == "VET" ? 0.04 :
     rowCoin == "XAU" ? 4000.0 :
     rowCoin == "XAG" ? 50.0 :
     rowCoin == "XPT" ? 1500.0 :
     rowCoin == "XPD" ? 1200.0 : 0.0
bool   rowIsCrypto  = syminfo.type == "crypto"
// a coin not listed, or not quoted in dollars: most coins are quoted with about 5 significant digits
float  rowRefPx     = rowIsCrypto and rowListedPx == 0 ? syminfo.mintick * 30000 :
     syminfo.type == "futures" or syminfo.type == "stock" ? 0.0 : rowListedPx
float  rowRaw       = rowRefPx * (rowIsCrypto ? 0.03 : 0.015) * math.sqrt(timeframe.in_seconds() / 86400) / 20
float  rowMag       = math.pow(10, math.floor(math.log10(rowRaw)))
float  rowF         = rowRaw / rowMag
//@variable Automatic footprint ticks per row: the row rounded to 1, 2, 2.5 or 5 times a power of ten, in ticks.
int    autoRow      = rowRefPx <= 0 ? 1 :
     math.max(1, int(math.round((rowF < 1.5 ? 1.0 : rowF < 2.25 ? 2.0 : rowF < 3.5 ? 2.5 : rowF < 7.5 ? 5.0 : 10.0) * rowMag / syminfo.mintick)))

int rowTicks = rowTicksInput > 0 ? rowTicksInput : autoRow
//@variable Footprint of the current bar (`na` without footprint data).
footprint fp = request.footprint(rowTicks)

type Zone
    box   bx
    float bottom
    float top
    bool  support
    int   startBar
    int   endBar = -1
    float ratio
    float volume

var array<Zone> zones = array.new<Zone>()

// ───────────────────────────────────────────── helpers
//@function Ratio of an aggressive level against its diagonal opposite, or `na` when the level does not count.
levelRatio(float aggressive, float opposite) =>
    float r = na
    if aggressive > 0 and aggressive >= minLevelVolInput
        if opposite > 0
            r := aggressive / opposite
        else if zeroInput == "Count as min ratio"
            r := minRatioInput
        else if zeroInput == "Count as 1"
            r := aggressive
    r

//@function Volume label: 165, 1.2k, 3.4M; crypto volumes keep decimals (18.5, 2.35, 0.042).
volText(float v) =>
    float a = math.abs(v)
    a >= 1e9 ? str.tostring(v / 1e9, "#.#") + "B" :
     a >= 1e6 ? str.tostring(v / 1e6, a >= 1e7 ? "#" : "#.#") + "M" :
     a >= 1e4 ? str.tostring(v / 1e3, "#") + "k" :
     a >= 1e3 ? str.tostring(v / 1e3, "#.#") + "k" :
     a >= 100 ? str.tostring(math.round(v)) :
     a >= 10 ? str.tostring(v, "#.#") : a >= 1 ? str.tostring(v, "#.##") : str.tostring(v, "#.###")

//@function Ratio text: 5x, 6.7x, 15x.
ratioText(float r) =>
    r >= 999 ? "999x" : str.tostring(r, "#.#") + "x"

//@function Fill opacity (0-100) for a ratio: minimum at the min ratio, full at the full-opacity ratio.
zoneOpacity(float r) =>
    float t = math.max(0.0, math.min(1.0, (r - minRatioInput) / math.max(0.0001, fullRatioInput - minRatioInput)))
    minOpacInput + (maxOpacInput - minOpacInput) * t

//@function Box of a stack from this bar. `live`: a stack of the forming bar, with a dashed outline.
zoneBox(bool support, float bottom, float top, float ratio, float stackVol, bool live) =>
    color c = support ? supColorInput : resColorInput
    float op = zoneOpacity(ratio)
    string txt = showLabelsInput ? ratioText(ratio) + " | " + volText(stackVol) : ""
    box.new(bar_index, top, bar_index + 1, bottom,
         border_color = live ? color.new(c, 20) : color.new(c, 100 - math.min(100.0, op * 1.35 + 4)), border_width = 1,
         border_style = live ? line.style_dashed : line.style_solid,
         bgcolor = color.new(c, 100 - op), text = txt, text_size = textSizeInput, text_color = textColorInput,
         text_halign = text.align_right, text_valign = text.align_center, text_wrap = text.wrap_none,
         text_formatting = text.format_bold)

newZone(bool support, float bottom, float top, float ratio, float stackVol) =>
    box b = zoneBox(support, bottom, top, ratio, stackVol, false)
    zones.push(Zone.new(b, bottom, top, support, bar_index, -1, ratio, stackVol))
    // keep the chart within the drawing budget: drop the oldest touched zone first, then the oldest one
    if zones.size() > maxZonesInput
        int drop = 0
        for [i, z] in zones
            if z.endBar >= 0
                drop := i
                break
        Zone old = zones.remove(drop)
        old.bx.delete()

// ───────────────────────────────────────────── touches (every update, so a realtime touch shows on the touching tick)
float tick = syminfo.mintick
string touchMsg = ""
if zones.size() > 0
    for i = zones.size() - 1 to 0
        Zone z = zones.get(i)
        if z.endBar < 0 and bar_index > z.startBar
            // highest traded price inside the zone = top edge minus one tick
            bool touched = high >= z.bottom - tick * 0.25 and low <= z.top - tick * 0.75
            if touched
                if discardNextInput and bar_index == z.startBar + 1
                    z.bx.delete()
                    zones.remove(i)
                else
                    z.endBar := bar_index
                    z.bx.set_right(bar_index)
                    if not keepTouchedInput
                        z.bx.delete()
                    touchMsg += (z.support ? "support " : "resistance ") + str.tostring(z.bottom, format.mintick) + "-" +
                         str.tostring(z.top - tick, format.mintick) + " (" + ratioText(z.ratio) + " | " + volText(z.volume) + ")  "
            else
                z.bx.set_right(bar_index + 1)

// touches only accumulate within a bar, so a changed message means a newly touched zone
varip int    sentBar = -1
varip string sentMsg = ""
if alertTouchInput and str.length(touchMsg) > 0
    if sentBar != bar_index
        sentBar := bar_index
        sentMsg := ""
    if touchMsg != sentMsg
        sentMsg := touchMsg
        alert(syminfo.ticker + " touched imbalance " + touchMsg, alert.freq_all)

// ───────────────────────────────────────────── stacks: the closed bar's become zones, the forming bar's show live
type Stack
    bool  support
    float bottom
    float top
    float ratio
    float volume

//@function Stacked diagonal imbalances of a footprint. With the close filter, buy stacks must lie below `closePx` and
// sell stacks above it.
stacksOf(footprint f, float closePx) =>
    array<Stack> out = array.new<Stack>()
    array<volume_row> rows = f.rows()
    int n = rows.size()
    if n >= 2
        // buy stacks: row i buy vs row i-1 sell (rows ascend in price)
        int   runStart = -1
        float runMax   = 0.0
        float runVol   = 0.0
        for i = 1 to n
            float r = na
            if i < n
                r := levelRatio(rows.get(i).buy_volume(), rows.get(i - 1).sell_volume())
            if not na(r) and r >= minRatioInput * (1 - 1e-9)   // fractional (crypto) volumes: a ratio of exactly 5 may sum to 4.9999999
                if runStart < 0
                    runStart := i
                    runMax   := r
                    runVol   := 0.0
                runMax := math.max(runMax, r)
                runVol += rows.get(i).buy_volume()
            else if runStart >= 0
                int runEnd = i - 1
                float bottom = rows.get(runStart).down_price()
                float top    = rows.get(runEnd).up_price()
                bool  okSide = not beyondCloseInput or top - tick * 0.5 < closePx
                if runEnd - runStart + 1 >= minStackInput and runVol >= minStackVolInput and okSide
                    out.push(Stack.new(true, bottom, top, runMax, runVol))
                runStart := -1
        // sell stacks: row i sell vs row i+1 buy
        runStart := -1
        for i = 0 to n - 1
            float r = na
            if i < n - 1
                r := levelRatio(rows.get(i).sell_volume(), rows.get(i + 1).buy_volume())
            if not na(r) and r >= minRatioInput * (1 - 1e-9)
                if runStart < 0
                    runStart := i
                    runMax   := r
                    runVol   := 0.0
                runMax := math.max(runMax, r)
                runVol += rows.get(i).sell_volume()
            else if runStart >= 0
                int runEnd = i - 1
                float bottom = rows.get(runStart).down_price()
                float top    = rows.get(runEnd).up_price()
                bool  okSide = not beyondCloseInput or bottom > closePx + tick * 0.5
                if runEnd - runStart + 1 >= minStackInput and runVol >= minStackVolInput and okSide
                    out.push(Stack.new(false, bottom, top, runMax, runVol))
                runStart := -1
    out

if barstate.isconfirmed and not na(fp)
    array<Stack> barStacks = stacksOf(fp, close)
    for st in barStacks
        newZone(st.support, st.bottom, st.top, st.ratio, st.volume)
// the forming bar: its stacks so far, dashed, redrawn on every update until the bar closes
if showLiveInput and barstate.islast and not barstate.isconfirmed and not na(fp)
    array<Stack> liveStacks = stacksOf(fp, close)
    for st in liveStacks
        zoneBox(st.support, st.bottom, st.top, st.ratio, st.volume, true)

// ───────────────────────────────────────────── status
var bool anyFp = false
if not na(fp)
    anyFp := true

// typical bar range of this chart, for the row size hint
float typRange = ta.sma(high - low, 100)

//@function A round price step near `px`: 1, 2, 2.5 or 5 times a power of ten.
niceRow(float px) =>
    float mag = math.pow(10, math.floor(math.log10(px)))
    float f   = px / mag
    (f < 1.5 ? 1.0 : f < 2.25 ? 2.0 : f < 3.5 ? 2.5 : f < 7.5 ? 5.0 : 10.0) * mag

//@function Status text when the row size does not suit the chart, "" when it does. `fine`: also hint when the rows are
// much finer or coarser than about 20 per typical bar.
rowHint(string name, int used, bool fine) =>
    int sug = math.max(1, int(math.round(niceRow(typRange / 20) / syminfo.mintick)))
    not anyFp and typRange / (used * syminfo.mintick) > 1000 ? name + ": too many price rows per bar for the footprint - set 'Ticks per row' to " + str.tostring(sug) :
         anyFp and fine and (used >= sug * 4 or sug >= used * 4) ? name + ": rows look too " + (used > sug ? "coarse" : "fine") + " for this chart - try 'Ticks per row' = " + str.tostring(sug) + " (now " + str.tostring(used) + ")" : ""

var table info = table.new(position.top_right, 1, 1)
if barstate.islast
    string hint = rowHint("IDC Imbalance", rowTicks, true)
    string msg  = not anyFp and str.length(hint) == 0 ? "IDC Imbalance: no footprint data (needs a Premium/Ultimate plan and a symbol with volume)" : hint
    table.cell(info, 0, 0, msg, text_color = color.orange, text_size = 9,
         tooltip = "Ticks per row: " + str.tostring(rowTicks))
