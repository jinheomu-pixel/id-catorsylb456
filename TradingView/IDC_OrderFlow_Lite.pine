//@version=6
// IDC Order Flow Lite: the four IDCator order-flow tools in one indicator, each switched on or off in the settings
// (Imbalance Levels, HVN Profile, Heavy Absorption, Pressure Toolkit). Clean-room replica of the tools shown in
// ProfitPro's videos; not their code. Not a buy/sell signal.
// Runs on every TradingView plan: the footprints (buy and sell volume per price) are ESTIMATED from candles, see
// "estimated footprint" below. For real footprint data use IDC Order Flow (needs a Premium or Ultimate plan).
// GENERATED by tools/build_suite.py from the four single-tool scripts in this folder: edit those, then run the build.
indicator("IDC Order Flow Lite", "IDC Lite", overlay = true, scale = scale.right, max_boxes_count = 500, max_labels_count = 500,
     max_lines_count = 500, max_polylines_count = 100)
// HVN zones start at their period's first bar (up to 5000 bars back)
max_bars_back(time, 5000)

G_ON = "Tools (on/off)"
bool hvnOn = input.bool(true, "HVN Profile", group = G_ON)
bool imbOn = input.bool(true, "Imbalance Levels", group = G_ON)
bool haOn  = input.bool(true, "Heavy Absorption", group = G_ON)
bool ptkOn = input.bool(false, "Pressure Toolkit", group = G_ON)
int    rowTicksInput = input.int(0, "Ticks per row (0 = auto)", minval = 0, group = G_ON,
     tooltip = "0 = auto: 1 tick on futures and stocks; on crypto and spot metals about 20 rows across a typical bar of this timeframe. The Data Window shows the value in use.")

G_EST = "Data (Lite: estimated from candles)"
string estLtfInput = input.string("Auto", "Intrabars", options = ["Auto", "Chart bars only", "1 second", "5 seconds", "15 seconds", "1 minute", "5 minutes"],
     group = G_EST, tooltip = "Lower-timeframe candles inside each chart bar give a finer estimate. Auto: 1 minute on charts up to 1 hour, 5 minutes up to 4 hours, 15 minutes up to 1 day, else 1 hour; none on 1-minute and lower charts (the chart bar itself is used). Seconds need a TradingView plan with second-based data.")

// ───────────────────────────────────────────── footprint row size
// request.footprint() takes a "simple int" row size, fixed when the script loads. Pine treats the parameters of our own
// functions as "series", so the size is worked out here at the top level, from syminfo and timeframe only: plain
// expressions, no function of ours, no switch, if, loop or :=.
// Futures and stocks: 1 tick. Crypto and spot metals (their tick is tiny next to their price): about 20 rows across a
// typical bar of the chart's timeframe (daily range: 3 % crypto, 1.5 % metals).
string rowCoin      = syminfo.basecurrency
string rowQuote     = syminfo.currency
bool   rowInDollars = rowQuote == "USD" or rowQuote == "USDT" or rowQuote == "USDC" or rowQuote == "FDUSD" or rowQuote == "BUSD" or
     rowQuote == "USDE" or rowQuote == "DAI" or rowQuote == "TUSD" or rowQuote == "PYUSD" or rowQuote == "USD1" or rowQuote == "EUR" or rowQuote == "GBP"
string rowTicker    = syminfo.ticker
//@variable Rough dollar price of a coin or a spot metal, 0 when it is not listed. Only the order of magnitude matters:
// a price off by 2x moves the row size by one step. Spot metals are also known by their ticker (OANDA:XAUUSD and other
// broker symbols may carry no base currency).
float  rowListedPx  = rowTicker == "XAUUSD" or rowTicker == "GOLD" ? 4000.0 : rowTicker == "XAGUSD" or rowTicker == "SILVER" ? 50.0 :
     rowTicker == "XPTUSD" or rowTicker == "PLATINUM" ? 1500.0 : rowTicker == "XPDUSD" or rowTicker == "PALLADIUM" ? 1200.0 :
     not rowInDollars ? 0.0 :
     rowCoin == "BTC" or rowCoin == "WBTC" ? 100000.0 :
     rowCoin == "ETH" or rowCoin == "WETH" ? 3500.0 :
     rowCoin == "BNB" ? 700.0 :
     rowCoin == "SOL" ? 180.0 :
     rowCoin == "XRP" ? 2.5 :
     rowCoin == "DOGE" or rowCoin == "HBAR" ? 0.25 :
     rowCoin == "ADA" or rowCoin == "JUP" ? 0.8 :
     rowCoin == "TRX" or rowCoin == "ALGO" ? 0.3 :
     rowCoin == "AVAX" or rowCoin == "HYPE" ? 30.0 :
     rowCoin == "LINK" or rowCoin == "INJ" ? 20.0 :
     rowCoin == "DOT" or rowCoin == "ATOM" or rowCoin == "RENDER" ? 6.0 :
     rowCoin == "TON" or rowCoin == "NEAR" or rowCoin == "FIL" or rowCoin == "TIA" ? 4.0 :
     rowCoin == "SHIB" ? 0.000015 :
     rowCoin == "PEPE" ? 0.00001 :
     rowCoin == "BONK" ? 0.00002 :
     rowCoin == "FLOKI" ? 0.0001 :
     rowCoin == "LTC" ? 100.0 :
     rowCoin == "BCH" ? 450.0 :
     rowCoin == "XLM" ? 0.35 :
     rowCoin == "SUI" ? 3.5 :
     rowCoin == "APT" or rowCoin == "ICP" ? 8.0 :
     rowCoin == "UNI" or rowCoin == "TRUMP" ? 10.0 :
     rowCoin == "ETC" ? 22.0 :
     rowCoin == "ARB" or rowCoin == "CRV" or rowCoin == "ENA" ? 0.6 :
     rowCoin == "OP" or rowCoin == "WIF" or rowCoin == "STX" or rowCoin == "LDO" or rowCoin == "WLD" ? 1.5 :
     rowCoin == "AAVE" ? 250.0 :
     rowCoin == "MKR" ? 1500.0 :
     rowCoin == "SEI" ? 0.4 :
     rowCoin == "FET" or rowCoin == "IMX" ? 1.2 :
     rowCoin == "TAO" ? 400.0 :
     rowCoin == "XMR" ? 300.0 :
     rowCoin == "ZEC" ? 50.0 :
     rowCoin == "ONDO" ? 1.0 :
     rowCoin == "PENGU" ? 0.02 :
     rowCoin == "KAS" ? 0.1 :
     rowCoin == "VET" ? 0.04 :
     rowCoin == "XAU" ? 4000.0 :
     rowCoin == "XAG" ? 50.0 :
     rowCoin == "XPT" ? 1500.0 :
     rowCoin == "XPD" ? 1200.0 : 0.0
bool   rowIsCrypto  = syminfo.type == "crypto"
// a coin not listed, or not quoted in dollars: most coins are quoted with about 5 significant digits
float  rowRefPx     = rowIsCrypto and rowListedPx == 0 ? syminfo.mintick * 30000 :
     syminfo.type == "futures" or syminfo.type == "stock" ? 0.0 : rowListedPx
float  rowRaw       = rowRefPx * (rowIsCrypto ? 0.03 : 0.015) * math.sqrt(timeframe.in_seconds() / 86400) / 20
float  rowMag       = math.pow(10, math.floor(math.log10(rowRaw)))
float  rowF         = rowRaw / rowMag
//@variable Automatic footprint ticks per row: the row rounded to 1, 2, 2.5 or 5 times a power of ten, in ticks.
int    autoRow      = rowRefPx <= 0 ? 1 :
     math.max(1, int(math.round((rowF < 1.5 ? 1.0 : rowF < 2.25 ? 2.0 : rowF < 3.5 ? 2.5 : rowF < 7.5 ? 5.0 : 10.0) * rowMag / syminfo.mintick)))

// Lite: rows of about 1/20 of a typical bar of this chart, from the daily range of the previous days (works for any
// symbol and timeframe); the first day, without a previous day, uses the automatic size above.
float estDayRange = timeframe.in_seconds() < 86400 ?
     request.security(syminfo.tickerid, "D", nz(ta.sma(high - low, 5), high - low)[1], lookahead = barmerge.lookahead_on) : na
float estBarRange = timeframe.in_seconds() < 86400 ? estDayRange * math.sqrt(timeframe.in_seconds() / 86400) :
     nz(ta.sma(high - low, 20), high - low)
float estRaw  = estBarRange / 20
float estMag  = math.pow(10, math.floor(math.log10(estRaw)))
float estF    = estRaw / estMag
int   estAuto = na(estRaw) or estRaw <= 0 ? autoRow :
     math.max(1, int(math.round((estF < 1.5 ? 1.0 : estF < 2.25 ? 2.0 : estF < 3.5 ? 2.5 : estF < 7.5 ? 5.0 : 10.0) * estMag / syminfo.mintick)))
int rowTicks = rowTicksInput > 0 ? rowTicksInput : estAuto

// ───────────────────────────────────────────── estimated footprint (Lite)
// TradingView sends real footprints (buy and sell volume per price) only to Premium and Ultimate plans; IDC Order Flow
// uses them. IDC Order Flow Lite estimates them from candles, so it runs on every plan:
// - each candle is assumed to travel open -> low -> high -> close when it closes up (or flat), open -> high -> low ->
//   close when it closes down; 90 % of its volume is spread along that path by distance (each tick travelled weighs
//   the same); up legs count as buying, down legs as selling; each leg leaves 20 % of its share at its end, where
//   price turned;
// - the other 10 % trades both ways around the close (its row and the rows above and below): the candle settles there;
// - the candles are the chart bar's intrabars (a lower timeframe, see 'Intrabars') or, without them, the bar itself.
// The four tools then run exactly as in IDC Order Flow. Volumes are estimates, not traded prints.
int    estChartSec = timeframe.in_seconds()
int    estLtfSec   = estLtfInput == "Auto" ? (estChartSec <= 60 ? 0 : estChartSec <= 3600 ? 60 : estChartSec <= 14400 ? 300 : estChartSec <= 86400 ? 900 : 3600) :
     estLtfInput == "1 second" ? 1 : estLtfInput == "5 seconds" ? 5 : estLtfInput == "15 seconds" ? 15 : estLtfInput == "1 minute" ? 60 :
     estLtfInput == "5 minutes" ? 300 : 0
string estLtf      = estLtfSec == 1 ? "1S" : estLtfSec == 5 ? "5S" : estLtfSec == 15 ? "15S" : estLtfSec == 60 ? "1" : estLtfSec == 300 ? "5" :
     estLtfSec == 900 ? "15" : "60"
bool   estUseLtf   = estLtfSec > 0 and estLtfSec < estChartSec

//@type One price row of an estimated footprint (the methods mirror TradingView's volume_row).
type EstRow
    float up
    float down
    float buy
    float sell

//@type Estimated footprint of a bar (the methods mirror TradingView's footprint).
type EstFootprint
    array<EstRow> items
    float buy
    float sell

method up_price(EstRow r) => r.up
method down_price(EstRow r) => r.down
method buy_volume(EstRow r) => r.buy
method sell_volume(EstRow r) => r.sell
method total_volume(EstRow r) => r.buy + r.sell
method delta(EstRow r) => r.buy - r.sell
method rows(EstFootprint f) => f.items.copy()
method buy_volume(EstFootprint f) => f.buy
method sell_volume(EstFootprint f) => f.sell
method total_volume(EstFootprint f) => f.buy + f.sell
method delta(EstFootprint f) => f.buy - f.sell

//@function Adds one leg of a candle's path, from tick `a` to tick `b` with `v` volume, to the rows (row `k0` first,
// `rt` ticks each): buying when it goes up, selling when it goes down. 80 % is spread along the leg; 20 % stays at its end,
// where price turned.
estLeg(array<float> buy, array<float> sell, int k0, int rt, int a, int b, float v) =>
    if b != a and v > 0
        array<float> side = b > a ? buy : sell
        int   n   = side.size()
        int   lo  = b > a ? a + 1 : b
        int   hi  = b > a ? b : a - 1
        float per = v * 0.8 / (hi - lo + 1)
        for k = int(math.floor(lo / rt)) to int(math.floor(hi / rt))
            int i  = math.max(0, math.min(n - 1, k - k0))
            int ov = math.min(hi, (k + 1) * rt - 1) - math.max(lo, k * rt) + 1
            side.set(i, side.get(i) + per * ov)
        int e = math.max(0, math.min(n - 1, int(math.floor(b / rt)) - k0))
        side.set(e, side.get(e) + v * 0.2)

//@function Adds a candle's estimated buying and selling to the rows (row `k0` first, `rt` ticks each): 10 % of its volume
// trades both ways around the close (its row and the rows above and below), the rest along its path.
estCandle(array<float> buy, array<float> sell, int k0, int rt, float o, float h, float l, float c, float v) =>
    if v > 0 and not na(o) and not na(h) and not na(l) and not na(c)
        int tkO  = math.round(o / syminfo.mintick)
        int tkH  = math.round(h / syminfo.mintick)
        int tkL  = math.round(l / syminfo.mintick)
        int tkC  = math.round(c / syminfo.mintick)
        int p1   = tkC >= tkO ? tkL : tkH
        int p2   = tkC >= tkO ? tkH : tkL
        int dist = math.abs(p1 - tkO) + math.abs(p2 - p1) + math.abs(tkC - p2)
        int n    = buy.size()
        int e    = int(math.floor(tkC / rt)) - k0
        float settle = dist == 0 ? v : v * 0.1
        for k = e - 1 to e + 1
            int i = math.max(0, math.min(n - 1, k))
            buy.set(i, buy.get(i) + settle / 6)
            sell.set(i, sell.get(i) + settle / 6)
        if dist > 0
            float pv = v - settle
            estLeg(buy, sell, k0, rt, tkO, p1, pv * math.abs(p1 - tkO) / dist)
            estLeg(buy, sell, k0, rt, p1, p2, pv * math.abs(p2 - p1) / dist)
            estLeg(buy, sell, k0, rt, p2, tkC, pv * math.abs(tkC - p2) / dist)

array<float> estO = na
array<float> estH = na
array<float> estL = na
array<float> estC = na
array<float> estV = na
if estUseLtf
    [io, ih, il, ic, iv] = request.security_lower_tf(syminfo.tickerid, estLtf, [open, high, low, close, volume])
    estO := io
    estH := ih
    estL := il
    estC := ic
    estV := iv

//@variable Estimated footprint of the current bar (`na` without volume, or above 2000 rows like a real footprint).
EstFootprint fp = na
int estK0 = int(math.floor(math.round(low / syminfo.mintick) / rowTicks))
int estK1 = int(math.floor(math.round(high / syminfo.mintick) / rowTicks))
if volume > 0 and estK1 - estK0 + 1 <= 2000
    int n = estK1 - estK0 + 1
    array<float> eb = array.new_float(n, 0.0)
    array<float> es = array.new_float(n, 0.0)
    if estUseLtf and not na(estV) and estV.size() > 0
        for j = 0 to estV.size() - 1
            estCandle(eb, es, estK0, rowTicks, estO.get(j), estH.get(j), estL.get(j), estC.get(j), estV.get(j))
    else
        estCandle(eb, es, estK0, rowTicks, open, high, low, close, volume)
    array<EstRow> er = array.new<EstRow>()
    for i = 0 to n - 1
        er.push(EstRow.new(math.round_to_mintick((estK0 + i + 1) * rowTicks * syminfo.mintick),
             math.round_to_mintick((estK0 + i) * rowTicks * syminfo.mintick), eb.get(i), es.get(i)))
    fp := EstFootprint.new(er, eb.sum(), es.sum())
float tick = syminfo.mintick

// ═════════════════════════════════════════════ HVN Profile (switch: hvnOn)
// ───────────────────────────────────────────── inputs
HVN_G_PER = "HVN Profile: Profile"
bool   hvnAutoPeriodInput = input.bool(true, "Auto profile timeframe", group = HVN_G_PER,
     tooltip = "About 15-25 bars per profile, on every chart timeframe: 15 s -> 5 min (as in the videos), 30 s -> 10 min, 1 min -> 15 min, 3 min -> 1 hour, 5 min -> 2 hours, 15 min -> 4 hours, 30 min and 1 hour -> 1 day, 4 hours -> 1 week, 1 day -> 1 month.")
string hvnPeriodInput     = input.timeframe("5", "Profile timeframe", group = HVN_G_PER,
     tooltip = "Length of each profile when 'Auto profile timeframe' is off: 1 minute to Weekly. Must be higher than the chart timeframe.")
int    hvnRowTicksInput   = input.int(0, "Row size (ticks, 0 = auto)", minval = 0, group = HVN_G_PER)
int    hvnTargetRowsInput = input.int(60, "Auto: rows per profile", minval = 5, maxval = 400, group = HVN_G_PER)

HVN_G_HVN = "HVN Profile: High volume nodes"
float  hvnThresholdInput  = input.float(70, "HVN threshold %", minval = 1, maxval = 100, group = HVN_G_HVN)
int    hvnSmoothingInput  = input.int(2, "Smoothing passes", minval = 0, maxval = 10, group = HVN_G_HVN)
float  hvnSensitivityInput = input.float(25, "Cluster sensitivity %", minval = 0, maxval = 100, group = HVN_G_HVN,
     tooltip = "0% keeps the whole cluster above the threshold, 100% shrinks it to its peak rows.")
int    hvnMinRowsInput    = input.int(2, "Min cluster size (rows)", minval = 1, group = HVN_G_HVN)
int    hvnGapInput        = input.int(1, "Gap tolerance (rows)", minval = 0, group = HVN_G_HVN)
int    hvnMaxClustersInput = input.int(2, "Max clusters per period", minval = 1, maxval = 10, group = HVN_G_HVN)
int    hvnGraceInput      = input.int(0, "Touch grace bars", minval = 0, group = HVN_G_HVN)

HVN_G_VIS = "HVN Profile: Display"
color  hvnPrimaryInput    = input.color(color.rgb(255, 165, 0), "Primary zone", group = HVN_G_VIS)
color  hvnSecondaryInput  = input.color(color.rgb(110, 125, 160), "Other zones", group = HVN_G_VIS)
int    hvnZoneOpacInput   = input.int(20, "Zone opacity %", minval = 1, maxval = 100, group = HVN_G_VIS)
int    hvnTouchedOpacInput = input.int(100, "Touched zone opacity (% of normal)", minval = 0, maxval = 100, group = HVN_G_VIS)
bool   hvnKeepTouchedInput = input.bool(false, "Keep touched zones", group = HVN_G_VIS)
bool   hvnShowLabelsInput = input.bool(true, "Show labels", group = HVN_G_VIS)
color  hvnLabelColorInput = input.color(color.white, "Label number", group = HVN_G_VIS)
color  hvnBuyPctInput     = input.color(color.rgb(46, 160, 110), "Buyers %", group = HVN_G_VIS)
color  hvnSellPctInput    = input.color(color.rgb(192, 74, 68), "Sellers %", group = HVN_G_VIS)
int    hvnLabelSizeInput  = input.int(9, "Label size (pt)", minval = 5, maxval = 30, group = HVN_G_VIS)
string hvnLabelValueInput = input.string("POC volume", "Label value", options = ["POC volume", "Cluster volume"], group = HVN_G_VIS)
bool   hvnShowPocInput    = input.bool(false, "Show POC line", group = HVN_G_VIS)
bool   hvnPocSecondaryInput = input.bool(false, "POC line on other zones", group = HVN_G_VIS)
bool   hvnExtendPocInput  = input.bool(true, "Extend POC line (dimmer)", group = HVN_G_VIS)
color  hvnPocColorInput   = input.color(color.rgb(218, 165, 32), "POC color", group = HVN_G_VIS)
bool   hvnShowHistInput   = input.bool(false, "Show period histograms", group = HVN_G_VIS)
bool   hvnShowLiveZonesInput = input.bool(true, "Show the forming period's nodes (live, dashed)", group = HVN_G_VIS)
bool   hvnShowLiveInput   = input.bool(false, "Show live (developing) histogram", group = HVN_G_VIS)
int    hvnHistWidthInput  = input.int(35, "Histogram width % of period", minval = 5, maxval = 100, group = HVN_G_VIS)
color  hvnHistColorInput  = input.color(color.new(color.rgb(112, 128, 144), 78), "Histogram", group = HVN_G_VIS)
color  hvnLiveColorInput  = input.color(color.new(color.rgb(112, 128, 144), 88), "Live histogram", group = HVN_G_VIS)
int    hvnMaxZonesInput   = input.int(40, "Max zones on chart", minval = 10, maxval = 100, group = HVN_G_VIS)

HVN_G_ALR = "HVN Profile: Alerts"
bool   hvnAlertTouchInput = input.bool(true, "Alert when price touches a zone", group = HVN_G_ALR,
     tooltip = "Create an alert on this indicator with 'Any alert() function call'.")

// ───────────────────────────────────────────── data

type hvnPeriod
    int             key
    int             startBar
    int             endBar
    int             lowTick
    int             highTick
    map<int, float> vol
    map<int, float> buy
    map<int, float> sell

type hvnCluster
    int   first
    int   last
    float vol
    float buy
    float sell
    int   pocTick
    float pocVol

type hvnHZone
    box   bx
    label num
    label pct
    line  poc
    line  pocExt
    float bottom
    float top
    float mid
    int   pocTick
    int   periodEndBar
    int   endBar = -1
    bool  primary

hvnNewPeriod(int key) =>
    hvnPeriod.new(key, bar_index, bar_index, 2147483647, -2147483647, map.new<int, float>(), map.new<int, float>(), map.new<int, float>())

var hvnPeriod       hvnCur   = na
var array<hvnHZone> hvnZones = array.new<hvnHZone>()
var array<polyline> hvnHists = array.new<polyline>()
var polyline     hvnLivePoly = na

//@function Adds one footprint (bar) to a period's tick maps.
hvnAddRows(hvnPeriod p, EstFootprint f) =>
    if not na(f)
        for vr in f.rows()
            float v = vr.total_volume()
            if v > 0
                int k = int(math.round(vr.down_price() / tick))
                p.vol.put(k, nz(p.vol.get(k)) + v)
                p.buy.put(k, nz(p.buy.get(k)) + vr.buy_volume())
                p.sell.put(k, nz(p.sell.get(k)) + vr.sell_volume())
                p.lowTick  := math.min(p.lowTick, k)
                p.highTick := math.max(p.highTick, k)

//@function Profile row size in ticks: a whole number of footprint rows.
hvnRowSize(int lowT, int highT) =>
    int raw = hvnRowTicksInput > 0 ? hvnRowTicksInput : math.max(1, int(math.ceil((highT - lowT + 1) / math.max(5.0, hvnTargetRowsInput))))
    int(math.ceil(raw / rowTicks)) * rowTicks

//@function Row volumes of a period (with optionally one extra, unconfirmed footprint).
hvnRowsOf(hvnPeriod p, EstFootprint extra, int lowT, int rt, int nRows) =>
    array<float> vol = array.new_float(nRows, 0.0)
    for k in p.vol.keys()
        int r = int(math.floor((k - lowT) / rt))
        vol.set(r, vol.get(r) + p.vol.get(k))
    if not na(extra)
        for vr in extra.rows()
            int k = int(math.round(vr.down_price() / tick))
            int r = int(math.floor((k - lowT) / rt))
            if r >= 0 and r < nRows
                vol.set(r, vol.get(r) + vr.total_volume())
    vol

//@function HVN clusters of a period, largest volume first.
hvnAnalyze(hvnPeriod p) =>
    array<hvnCluster> result = array.new<hvnCluster>()
    if p.vol.size() > 0 and p.highTick >= p.lowTick
        int lowT  = p.lowTick
        int rt    = hvnRowSize(p.lowTick, p.highTick)
        int nRows = int(math.floor((p.highTick - lowT) / rt)) + 1
        array<float> vol  = hvnRowsOf(p, na, lowT, rt, nRows)
        array<float> buy  = array.new_float(nRows, 0.0)
        array<float> sell = array.new_float(nRows, 0.0)
        for k in p.vol.keys()
            int r = int(math.floor((k - lowT) / rt))
            buy.set(r, buy.get(r) + nz(p.buy.get(k)))
            sell.set(r, sell.get(r) + nz(p.sell.get(k)))
        // 1-2-1 smoothing passes: single-row spikes flatten, plateaus (nodes) stay
        array<float> sm = vol.copy()
        for pass = 1 to hvnSmoothingInput
            if pass > hvnSmoothingInput
                break
            array<float> nxt = array.new_float(nRows, 0.0)
            for r = 0 to nRows - 1
                float s = 2 * sm.get(r)
                float w = 2.0
                if r > 0
                    s += sm.get(r - 1)
                    w += 1
                if r < nRows - 1
                    s += sm.get(r + 1)
                    w += 1
                nxt.set(r, s / w)
            sm := nxt
        float thr = sm.max() * hvnThresholdInput / 100
        int row = 0
        while row < nRows
            if sm.get(row) < thr
                row += 1
                continue
            // grow the cluster, bridging gaps of up to `gapInput` rows
            int first = row
            int last  = row
            int gap   = 0
            int r2    = row + 1
            while r2 < nRows
                if sm.get(r2) >= thr
                    last := r2
                    gap  := 0
                else
                    gap += 1
                    if gap > hvnGapInput
                        break
                r2 += 1
            row := last + 1
            // trim weak edges relative to the cluster's own peak, then regrow to the minimum size
            float peak = 0.0
            for r = first to last
                peak := math.max(peak, sm.get(r))
            float edge = thr + (peak - thr) * hvnSensitivityInput / 100
            int uFirst = first
            int uLast  = last
            while first < last and sm.get(first) < edge
                first += 1
            while last > first and sm.get(last) < edge
                last -= 1
            while last - first + 1 < hvnMinRowsInput and (first > uFirst or last < uLast)
                if first > uFirst and (last >= uLast or sm.get(first - 1) >= sm.get(last + 1))
                    first -= 1
                else
                    last += 1
            if last - first + 1 >= hvnMinRowsInput
                hvnCluster c = hvnCluster.new(first, last, 0.0, 0.0, 0.0, lowT + first * rt, 0.0)
                for r = first to last
                    c.vol  += vol.get(r)
                    c.buy  += buy.get(r)
                    c.sell += sell.get(r)
                // POC: busiest single price inside the cluster
                int lo = lowT + first * rt
                int hi = lowT + (last + 1) * rt - 1
                for t = lo to hi
                    float v = nz(p.vol.get(t))
                    if v > c.pocVol
                        c.pocVol  := v
                        c.pocTick := t
                result.push(c)
        // largest first, at most `maxClustersInput`
        if result.size() > 1
            array<float> vols = array.new_float()
            for c in result
                vols.push(c.vol)
            array<int> order_ = vols.sort_indices(order.descending)
            array<hvnCluster> sorted = array.new<hvnCluster>()
            for i in order_
                if sorted.size() < hvnMaxClustersInput
                    sorted.push(result.get(i))
            result := sorted
    [result, hvnRowSize(p.lowTick, p.highTick)]

//@function Volume label: 165, 1.2k, 3.4M; crypto volumes keep decimals (18.5, 2.35, 0.042).
hvnVolText(float v) =>
    float a = math.abs(v)
    a >= 1e9 ? str.tostring(v / 1e9, "#.#") + "B" :
     a >= 1e6 ? str.tostring(v / 1e6, a >= 1e7 ? "#" : "#.#") + "M" :
     a >= 1e4 ? str.tostring(v / 1e3, "#") + "k" :
     a >= 1e3 ? str.tostring(v / 1e3, "#.#") + "k" :
     a >= 100 ? str.tostring(math.round(v)) :
     a >= 10 ? str.tostring(v, "#.#") : a >= 1 ? str.tostring(v, "#.##") : str.tostring(v, "#.###")

hvnZoneColor(hvnHZone z) =>
    float op = hvnZoneOpacInput * (z.endBar >= 0 ? hvnTouchedOpacInput / 100 : 1.0)
    color.new(z.primary ? hvnPrimaryInput : hvnSecondaryInput, 100 - op)

//@function Profile outline as a filled polyline from the period's first bar to the right.
hvnHistPoly(hvnPeriod p, EstFootprint extra, int x0, int widthBars, color col) =>
    polyline pl = na
    if p.vol.size() > 0 or not na(extra)
        int lowT  = p.lowTick
        int highT = p.highTick
        if not na(extra)
            for vr in extra.rows()
                int k = int(math.round(vr.down_price() / tick))
                lowT  := math.min(lowT, k)
                highT := math.max(highT, k)
        if highT >= lowT
            int rt    = hvnRowSize(lowT, highT)
            int nRows = int(math.floor((highT - lowT) / rt)) + 1
            array<float> vol = hvnRowsOf(p, extra, lowT, rt, nRows)
            float mx = vol.max()
            if mx > 0
                array<chart.point> pts = array.new<chart.point>()
                pts.push(chart.point.from_index(x0, lowT * tick))
                for r = 0 to nRows - 1
                    int w = math.min(int(math.round(widthBars * vol.get(r) / mx)), bar_index + 500 - x0)
                    float yLo = (lowT + r * rt) * tick
                    float yHi = (lowT + (r + 1) * rt) * tick
                    pts.push(chart.point.from_index(x0 + w, yLo))
                    pts.push(chart.point.from_index(x0 + w, yHi))
                pts.push(chart.point.from_index(x0, (lowT + nRows * rt) * tick))
                pl := polyline.new(pts, closed = true, line_color = color.new(col, 100), fill_color = col)
    pl

hvnDeleteZone(hvnHZone z) =>
    z.bx.delete()
    if not na(z.num)
        z.num.delete()
    if not na(z.pct)
        z.pct.delete()
    if not na(z.poc)
        z.poc.delete()
    if not na(z.pocExt)
        z.pocExt.delete()

//@function Moves a zone's right end (and its labels and POC extension) to bar `x`.
hvnSetRight(hvnHZone z, int x) =>
    z.bx.set_right(x)
    if not na(z.num)
        z.num.set_x(x)
    if not na(z.pct)
        z.pct.set_x(x)
    if not na(z.pocExt)
        z.pocExt.set_x2(x)

//@function The two labels of a node at `mid`: the number in white and " | P%" in the dominant side's color.
hvnZoneLabels(hvnCluster c, float mid) =>
    label ln = na
    label lp = na
    if hvnShowLabelsInput
        float sum   = c.buy + c.sell
        float share = sum > 0 ? c.buy / sum : 0.5
        bool  buyers = share >= 0.5
        int   pctV  = math.max(51, int(math.round(100 * (buyers ? share : 1 - share))))
        string num  = hvnVolText(hvnLabelValueInput == "POC volume" ? c.pocVol : c.vol)
        string pctS = sum > 0 ? " | " + str.tostring(pctV) + "%" : ""
        // two labels, same monospace font
        ln := label.new(bar_index + 1, mid, num + str.repeat(" ", str.length(pctS)), style = label.style_label_right,
             color = color.new(color.black, 100), textcolor = hvnLabelColorInput, size = hvnLabelSizeInput,
             text_font_family = font.family_monospace, text_formatting = text.format_bold)
        if sum > 0
            lp := label.new(bar_index + 1, mid, pctS, style = label.style_label_right, color = color.new(color.black, 100),
                 textcolor = buyers ? hvnBuyPctInput : hvnSellPctInput, size = hvnLabelSizeInput, text_font_family = font.family_monospace,
                 text_formatting = text.format_bold)
    [ln, lp]

//@function A copy of a period (its volume maps are copied too).
hvnCopyPeriod(hvnPeriod p) =>
    hvnPeriod.new(p.key, p.startBar, p.endBar, p.lowTick, p.highTick, p.vol.copy(), p.buy.copy(), p.sell.copy())

//@function The forming period's nodes so far: dashed outlines, drawn again on every update until the period closes.
hvnLiveZones(hvnPeriod p) =>
    [clusters, rt] = hvnAnalyze(p)
    int x0 = math.max(p.startBar, bar_index - 4999)
    int i = 0
    for c in clusters
        color base = i == 0 ? hvnPrimaryInput : hvnSecondaryInput
        i += 1
        float bottom = (p.lowTick + c.first * rt) * tick
        float top    = math.min(p.lowTick + (c.last + 1) * rt, p.highTick + rowTicks) * tick
        box.new(x0, top, bar_index + 1, bottom, border_color = color.new(base, 25), border_style = line.style_dashed,
             bgcolor = color.new(base, 100 - hvnZoneOpacInput))
        [ln, lp] = hvnZoneLabels(c, (bottom + top) / 2)
    i

//@function Turns a finished period into zones (and an optional histogram).
hvnFinalize(hvnPeriod p) =>
    [clusters, rt] = hvnAnalyze(p)
    // drawings cannot start more than 10,000 bars back (and must stay inside max_bars_back)
    int x0 = math.max(p.startBar, bar_index - 4999)
    int i = 0
    for c in clusters
        bool primary = i == 0
        i += 1
        float bottom = (p.lowTick + c.first * rt) * tick
        // a partly traded top row ends at the period's highest price
        float top    = math.min(p.lowTick + (c.last + 1) * rt, p.highTick + rowTicks) * tick
        float mid    = (bottom + top) / 2
        box b = box.new(x0, top, bar_index + 1, bottom, border_color = color.new(color.black, 100),
             bgcolor = color.new(primary ? hvnPrimaryInput : hvnSecondaryInput, 100 - hvnZoneOpacInput))
        [ln, lp] = hvnZoneLabels(c, mid)
        line l1 = na
        line l2 = na
        if hvnShowPocInput and (primary or hvnPocSecondaryInput)
            float py = (c.pocTick + rowTicks / 2) * tick
            int brightEnd = math.min(x0 + 6, bar_index + 1)
            l1 := line.new(x0, py, brightEnd, py, color = color.new(hvnPocColorInput, 40), width = 2)
            if hvnExtendPocInput
                l2 := line.new(brightEnd, py, bar_index + 1, py, color = color.new(hvnPocColorInput, 70), width = 2)
        hvnZones.push(hvnHZone.new(b, ln, lp, l1, l2, bottom, top, mid, c.pocTick, p.endBar, -1, primary))
    if hvnShowHistInput
        polyline h = hvnHistPoly(p, na, x0, math.max(1, int((p.endBar - p.startBar + 1) * hvnHistWidthInput / 100)), hvnHistColorInput)
        if not na(h)
            hvnHists.push(h)
            if hvnHists.size() > 90
                hvnHists.shift().delete()
    // drawing budget: oldest touched zones go first, then the oldest
    while hvnZones.size() > hvnMaxZonesInput
        int drop = 0
        for [k, z] in hvnZones
            if z.endBar >= 0
                drop := k
                break
        hvnDeleteZone(hvnZones.remove(drop))

// ───────────────────────────────────────────── period bookkeeping
int    hvnChartSec  = timeframe.in_seconds()
//@variable Profile timeframe in use: automatic (about 15-25 bars per profile) or the input.
string hvnProfileTf = not hvnAutoPeriodInput ? hvnPeriodInput : hvnChartSec <= 15 ? "5" : hvnChartSec <= 30 ? "10" : hvnChartSec <= 60 ? "15" :
     hvnChartSec <= 180 ? "60" : hvnChartSec <= 300 ? "120" : hvnChartSec <= 900 ? "240" : hvnChartSec <= 3600 ? "D" : hvnChartSec <= 14400 ? "W" :
     hvnChartSec <= 86400 ? "M" : hvnChartSec <= 604800 ? "3M" : "12M"
int    hvnPKey      = time(hvnProfileTf)
bool   hvnTfTooHigh = hvnChartSec >= timeframe.in_seconds(hvnProfileTf)
// end of an intraday period (Daily/Weekly periods close when the next period's first bar arrives)
int    hvnPEnd      = timeframe.in_seconds(hvnProfileTf) < 86400 and not na(hvnPKey) ? hvnPKey + timeframe.in_seconds(hvnProfileTf) * 1000 : na

// a new period started: the previous one is complete (if it was not finalized at its last bar already)
if hvnOn and (not na(hvnCur) and hvnPKey != hvnCur.key)
    hvnFinalize(hvnCur)
    hvnCur := na
if hvnOn and (na(hvnCur))
    hvnCur := hvnNewPeriod(hvnPKey)

// ───────────────────────────────────────────── touches and extension (every update)
string hvnTouchMsg = ""
if hvnOn
    for z in hvnZones
        if z.endBar < 0
            bool canTouch = bar_index > z.periodEndBar + hvnGraceInput
            if canTouch and high >= z.bottom - tick * 0.25 and low <= z.top - tick * 0.75
                z.endBar := bar_index
                hvnSetRight(z, bar_index)
                z.bx.set_bgcolor(hvnZoneColor(z))
                if not hvnKeepTouchedInput
                    hvnDeleteZone(z)
                hvnTouchMsg += str.tostring(z.bottom, format.mintick) + "-" + str.tostring(z.top - tick, format.mintick) + "  "
            else
                hvnSetRight(z, bar_index + 1)

// touches only accumulate within a bar, so a changed message means a newly touched zone
varip int    hvnSentBar = -1
varip string hvnSentMsg = ""
if hvnOn and (hvnAlertTouchInput and str.length(hvnTouchMsg) > 0)
    if hvnSentBar != bar_index
        hvnSentBar := bar_index
        hvnSentMsg := ""
    if hvnTouchMsg != hvnSentMsg
        hvnSentMsg := hvnTouchMsg
        alert(syminfo.ticker + " touched HVN zone " + hvnTouchMsg, alert.freq_all)

// ───────────────────────────────────────────── the closed bar joins its period; a period ending with this bar closes now
if hvnOn and (barstate.isconfirmed and not hvnTfTooHigh)
    hvnAddRows(hvnCur, fp)
    hvnCur.endBar := bar_index
    if not na(hvnPEnd) and time_close >= hvnPEnd
        hvnFinalize(hvnCur)
        hvnCur := na



// ───────────────────────────────────────────── forming period: its nodes so far (live), and the developing histogram
if hvnOn and (hvnShowLiveZonesInput and barstate.islast and not barstate.isconfirmed and not hvnTfTooHigh and not na(hvnCur))
    hvnPeriod livePer = hvnCopyPeriod(hvnCur)
    hvnAddRows(livePer, fp)
    if livePer.vol.size() > 0
        hvnLiveZones(livePer)
if hvnOn and (barstate.islast and hvnShowLiveInput and not hvnTfTooHigh)
    if not na(hvnLivePoly)
        hvnLivePoly.delete()
    hvnPeriod p = na(hvnCur) ? hvnNewPeriod(hvnPKey) : hvnCur
    EstFootprint extra = barstate.isconfirmed ? na : fp
    hvnLivePoly := hvnHistPoly(p, extra, math.max(p.startBar, bar_index - 4999), math.max(2, int(math.round((timeframe.in_seconds(hvnProfileTf) / hvnChartSec) * hvnHistWidthInput / 100))), hvnLiveColorInput)

// ═════════════════════════════════════════════ Imbalance Levels (switch: imbOn)
// ───────────────────────────────────────────── inputs
IMB_G_DET = "Imbalance Levels: Detection"
float  imbMinRatioInput   = input.float(5.0, "Min imbalance ratio", minval = 1.1, step = 0.5, group = IMB_G_DET,
     tooltip = "Diagonal comparison: buy volume at a price vs sell volume one row lower (and sell vs buy one row higher).")
int    imbMinStackInput   = input.int(3, "Min stacked levels", minval = 1, group = IMB_G_DET)
float  imbMinLevelVolInput = input.float(0, "Min volume per level", minval = 0, group = IMB_G_DET,
     tooltip = "A level only counts when its aggressive volume is at least this much.")
float  imbMinStackVolInput = input.float(0, "Min stack volume", minval = 0, group = IMB_G_DET)
string imbZeroInput       = input.string("Count as min ratio", "Zero-value handling", options = ["Count as min ratio", "Count as 1", "Skip"], group = IMB_G_DET,
     tooltip = "What to do when the opposite diagonal level traded nothing. 'Count as min ratio' gives labels like '5x | 8' as in the videos.")
bool   imbBeyondCloseInput = input.bool(true, "Buy stacks below close, sell stacks above", group = IMB_G_DET)
bool   imbDiscardNextInput = input.bool(false, "Discard if next bar touches", group = IMB_G_DET)

IMB_G_VIS = "Imbalance Levels: Display"
color  imbSupColorInput   = input.color(color.rgb(34, 171, 92), "Support (buy stack)", group = IMB_G_VIS)
color  imbResColorInput   = input.color(color.rgb(233, 57, 61), "Resistance (sell stack)", group = IMB_G_VIS)
int    imbMinOpacInput    = input.int(8, "Opacity at min ratio %", minval = 1, maxval = 100, group = IMB_G_VIS)
int    imbMaxOpacInput    = input.int(45, "Opacity at full ratio %", minval = 1, maxval = 100, group = IMB_G_VIS)
float  imbFullRatioInput  = input.float(15, "Full-opacity ratio", minval = 1.1, group = IMB_G_VIS)
bool   imbShowLabelsInput = input.bool(true, "Show labels", group = IMB_G_VIS)
color  imbTextColorInput  = input.color(color.rgb(224, 224, 224), "Label color", group = IMB_G_VIS)
int    imbTextSizeInput   = input.int(9, "Label size (pt)", minval = 5, maxval = 30, group = IMB_G_VIS)
bool   imbKeepTouchedInput = input.bool(false, "Keep touched zones", group = IMB_G_VIS)
bool   imbShowLiveInput   = input.bool(true, "Show the forming bar's stacks (live, dashed)", group = IMB_G_VIS)
int    imbMaxZonesInput   = input.int(60, "Max zones on chart", minval = 10, maxval = 300, group = IMB_G_VIS)

IMB_G_ALR = "Imbalance Levels: Alerts"
bool   imbAlertTouchInput = input.bool(true, "Alert when price touches a zone", group = IMB_G_ALR,
     tooltip = "Create an alert on this indicator with 'Any alert() function call'.")

// ───────────────────────────────────────────── data

type imbZone
    box   bx
    float bottom
    float top
    bool  support
    int   startBar
    int   endBar = -1
    float ratio
    float volume

var array<imbZone> imbZones = array.new<imbZone>()

// ───────────────────────────────────────────── helpers
//@function Ratio of an aggressive level against its diagonal opposite, or `na` when the level does not count.
imbLevelRatio(float aggressive, float opposite) =>
    float r = na
    if aggressive > 0 and aggressive >= imbMinLevelVolInput
        if opposite > 0
            r := aggressive / opposite
        else if imbZeroInput == "Count as min ratio"
            r := imbMinRatioInput
        else if imbZeroInput == "Count as 1"
            r := aggressive
    r

//@function Volume label: 165, 1.2k, 3.4M; crypto volumes keep decimals (18.5, 2.35, 0.042).
imbVolText(float v) =>
    float a = math.abs(v)
    a >= 1e9 ? str.tostring(v / 1e9, "#.#") + "B" :
     a >= 1e6 ? str.tostring(v / 1e6, a >= 1e7 ? "#" : "#.#") + "M" :
     a >= 1e4 ? str.tostring(v / 1e3, "#") + "k" :
     a >= 1e3 ? str.tostring(v / 1e3, "#.#") + "k" :
     a >= 100 ? str.tostring(math.round(v)) :
     a >= 10 ? str.tostring(v, "#.#") : a >= 1 ? str.tostring(v, "#.##") : str.tostring(v, "#.###")

//@function Ratio text: 5x, 6.7x, 15x.
imbRatioText(float r) =>
    r >= 999 ? "999x" : str.tostring(r, "#.#") + "x"

//@function Fill opacity (0-100) for a ratio: minimum at the min ratio, full at the full-opacity ratio.
imbZoneOpacity(float r) =>
    float t = math.max(0.0, math.min(1.0, (r - imbMinRatioInput) / math.max(0.0001, imbFullRatioInput - imbMinRatioInput)))
    imbMinOpacInput + (imbMaxOpacInput - imbMinOpacInput) * t

//@function Box of a stack from this bar. `live`: a stack of the forming bar, with a dashed outline.
imbZoneBox(bool support, float bottom, float top, float ratio, float stackVol, bool live) =>
    color c = support ? imbSupColorInput : imbResColorInput
    float op = imbZoneOpacity(ratio)
    string txt = imbShowLabelsInput ? imbRatioText(ratio) + " | " + imbVolText(stackVol) : ""
    box.new(bar_index, top, bar_index + 1, bottom,
         border_color = live ? color.new(c, 20) : color.new(c, 100 - math.min(100.0, op * 1.35 + 4)), border_width = 1,
         border_style = live ? line.style_dashed : line.style_solid,
         bgcolor = color.new(c, 100 - op), text = txt, text_size = imbTextSizeInput, text_color = imbTextColorInput,
         text_halign = text.align_right, text_valign = text.align_center, text_wrap = text.wrap_none,
         text_formatting = text.format_bold)

imbNewZone(bool support, float bottom, float top, float ratio, float stackVol) =>
    box b = imbZoneBox(support, bottom, top, ratio, stackVol, false)
    imbZones.push(imbZone.new(b, bottom, top, support, bar_index, -1, ratio, stackVol))
    // keep the chart within the drawing budget: drop the oldest touched zone first, then the oldest one
    if imbZones.size() > imbMaxZonesInput
        int drop = 0
        for [i, z] in imbZones
            if z.endBar >= 0
                drop := i
                break
        imbZone old = imbZones.remove(drop)
        old.bx.delete()

// ───────────────────────────────────────────── touches (every update, so a realtime touch shows on the touching tick)
string imbTouchMsg = ""
if imbOn and (imbZones.size() > 0)
    for i = imbZones.size() - 1 to 0
        imbZone z = imbZones.get(i)
        if z.endBar < 0 and bar_index > z.startBar
            // highest traded price inside the zone = top edge minus one tick
            bool touched = high >= z.bottom - tick * 0.25 and low <= z.top - tick * 0.75
            if touched
                if imbDiscardNextInput and bar_index == z.startBar + 1
                    z.bx.delete()
                    imbZones.remove(i)
                else
                    z.endBar := bar_index
                    z.bx.set_right(bar_index)
                    if not imbKeepTouchedInput
                        z.bx.delete()
                    imbTouchMsg += (z.support ? "support " : "resistance ") + str.tostring(z.bottom, format.mintick) + "-" +
                         str.tostring(z.top - tick, format.mintick) + " (" + imbRatioText(z.ratio) + " | " + imbVolText(z.volume) + ")  "
            else
                z.bx.set_right(bar_index + 1)

// touches only accumulate within a bar, so a changed message means a newly touched zone
varip int    imbSentBar = -1
varip string imbSentMsg = ""
if imbOn and (imbAlertTouchInput and str.length(imbTouchMsg) > 0)
    if imbSentBar != bar_index
        imbSentBar := bar_index
        imbSentMsg := ""
    if imbTouchMsg != imbSentMsg
        imbSentMsg := imbTouchMsg
        alert(syminfo.ticker + " touched imbalance " + imbTouchMsg, alert.freq_all)

// ───────────────────────────────────────────── stacks: the closed bar's become zones, the forming bar's show live
type imbStack
    bool  support
    float bottom
    float top
    float ratio
    float volume

//@function Stacked diagonal imbalances of a footprint. With the close filter, buy stacks must lie below `closePx` and
// sell stacks above it.
imbStacksOf(EstFootprint f, float closePx) =>
    array<imbStack> out = array.new<imbStack>()
    array<EstRow> rows = f.rows()
    int n = rows.size()
    if n >= 2
        // buy stacks: row i buy vs row i-1 sell (rows ascend in price)
        int   runStart = -1
        float runMax   = 0.0
        float runVol   = 0.0
        for i = 1 to n
            float r = na
            if i < n
                r := imbLevelRatio(rows.get(i).buy_volume(), rows.get(i - 1).sell_volume())
            if not na(r) and r >= imbMinRatioInput * (1 - 1e-9)   // fractional (crypto) volumes: a ratio of exactly 5 may sum to 4.9999999
                if runStart < 0
                    runStart := i
                    runMax   := r
                    runVol   := 0.0
                runMax := math.max(runMax, r)
                runVol += rows.get(i).buy_volume()
            else if runStart >= 0
                int runEnd = i - 1
                float bottom = rows.get(runStart).down_price()
                float top    = rows.get(runEnd).up_price()
                bool  okSide = not imbBeyondCloseInput or top - tick * 0.5 < closePx
                if runEnd - runStart + 1 >= imbMinStackInput and runVol >= imbMinStackVolInput and okSide
                    out.push(imbStack.new(true, bottom, top, runMax, runVol))
                runStart := -1
        // sell stacks: row i sell vs row i+1 buy
        runStart := -1
        for i = 0 to n - 1
            float r = na
            if i < n - 1
                r := imbLevelRatio(rows.get(i).sell_volume(), rows.get(i + 1).buy_volume())
            if not na(r) and r >= imbMinRatioInput * (1 - 1e-9)
                if runStart < 0
                    runStart := i
                    runMax   := r
                    runVol   := 0.0
                runMax := math.max(runMax, r)
                runVol += rows.get(i).sell_volume()
            else if runStart >= 0
                int runEnd = i - 1
                float bottom = rows.get(runStart).down_price()
                float top    = rows.get(runEnd).up_price()
                bool  okSide = not imbBeyondCloseInput or bottom > closePx + tick * 0.5
                if runEnd - runStart + 1 >= imbMinStackInput and runVol >= imbMinStackVolInput and okSide
                    out.push(imbStack.new(false, bottom, top, runMax, runVol))
                runStart := -1
    out

if imbOn and (barstate.isconfirmed and not na(fp))
    array<imbStack> barStacks = imbStacksOf(fp, close)
    for st in barStacks
        imbNewZone(st.support, st.bottom, st.top, st.ratio, st.volume)
// the forming bar: its stacks so far, dashed, redrawn on every update until the bar closes
if imbOn and (imbShowLiveInput and barstate.islast and not barstate.isconfirmed and not na(fp))
    array<imbStack> liveStacks = imbStacksOf(fp, close)
    for st in liveStacks
        imbZoneBox(st.support, st.bottom, st.top, st.ratio, st.volume, true)

// ───────────────────────────────────────────── status

// ═════════════════════════════════════════════ Heavy Absorption (switch: haOn)
// ───────────────────────────────────────────── inputs
HA_G_DET = "Heavy Absorption: Detection"
int    haLookbackInput  = input.int(100, "Lookback bars", minval = 5, maxval = 2000, group = HA_G_DET)
float  haKInput         = input.float(2.0, "Std dev multiplier", minval = 0, step = 0.1, group = HA_G_DET,
     tooltip = "Higher = fewer, bigger markers.")
int    haMinSamplesInput = input.int(40, "Min samples before marking", minval = 5, group = HA_G_DET,
     tooltip = "Samples = the heaviest buy price and the heaviest sell price of every closed bar.")
float  haMinVolInput    = input.float(0, "Min volume filter", minval = 0, group = HA_G_DET, tooltip = "Hides markers below this volume.")
string haSideInput      = input.string("Both", "Sides", options = ["Both", "Buyers only", "Sellers only"], group = HA_G_DET)

HA_G_VIS = "Heavy Absorption: Display"
color  haBullInput      = input.color(color.rgb(38, 166, 91), "Bull circle", group = HA_G_VIS)
color  haBearInput      = input.color(color.rgb(235, 64, 52), "Bear circle", group = HA_G_VIS)
int    haFillTranspInput = input.int(68, "Fill transparency %", minval = 0, maxval = 100, group = HA_G_VIS)
bool   haRingInput      = input.bool(true, "Ring", group = HA_G_VIS)
color  haTextInput      = input.color(color.white, "Text color", group = HA_G_VIS)
int    haTextSizeInput  = input.int(9, "Text size (pt)", minval = 5, maxval = 30, group = HA_G_VIS)
string haSizingInput    = input.string("Relative to markers", "Circle sizing", options = ["Relative to markers", "Absolute"], group = HA_G_VIS,
     tooltip = "Relative: the biggest marker on the chart gets the max size (square-root scale). Absolute: size grows with volume / threshold.")
int    haMinSizeInput   = input.int(16, "Min circle size (pt)", minval = 4, maxval = 120, group = HA_G_VIS)
int    haMaxSizeInput   = input.int(46, "Max circle size (pt)", minval = 4, maxval = 160, group = HA_G_VIS)
float  haFullRatioInput = input.float(6, "Absolute: volume / threshold at max size", minval = 1.1, group = HA_G_VIS)
int    haMaxMarkersInput = input.int(50, "Max markers on chart", minval = 10, maxval = 50, group = HA_G_VIS)

HA_G_ALR = "Heavy Absorption: Alerts"
string haAlertModeInput = input.string("Off", "Alert", options = ["Off", "Live (when a circle appears)", "On bar close"], group = HA_G_ALR,
     tooltip = "Create an alert on this indicator with 'Any alert() function call'. Live: once per bar and side, on the tick the circle appears.")

// ───────────────────────────────────────────── data

type haMarker
    label circle
    label ring
    label txt
    int   bar
    int   side
    float price
    float volume
    float threshold

var array<haMarker> haMarkers = array.new<haMarker>()
// rolling statistics of each closed bar's heaviest aggressive price (buy side and sell side), one bucket per bar
var array<float> haWN = array.new_float()
var array<float> haWS = array.new_float()
var array<float> haWQ = array.new_float()
var float haTotN = 0.0
var float haTotS = 0.0
var float haTotQ = 0.0

//@function Number text: 384, 1.2K, 12K, 3.4M (capital K as in the videos); crypto volumes keep decimals (18.5, 2.35, 0.042).
haVolText(float v) =>
    float a = math.abs(v)
    a >= 1e9 ? str.tostring(v / 1e9, "#.#") + "B" :
     a >= 1e6 ? str.tostring(v / 1e6, a >= 1e7 ? "#" : "#.#") + "M" :
     a >= 1e4 ? str.tostring(v / 1e3, "#") + "K" :
     a >= 1e3 ? str.tostring(v / 1e3, "#.#") + "K" :
     a >= 100 ? str.tostring(math.round(v)) :
     a >= 10 ? str.tostring(v, "#.#") : a >= 1 ? str.tostring(v, "#.##") : str.tostring(v, "#.###")

haCircleSize(float v, float haThr, float vmax) =>
    float t = haSizingInput == "Absolute" ?
         math.sqrt(math.max(0.0, math.min(1.0, (v / math.max(haThr, 1e-9) - 1) / (haFullRatioInput - 1)))) :
         math.sqrt(math.max(0.0, math.min(1.0, v / math.max(vmax, 1e-9))))
    int(math.round(haMinSizeInput + (haMaxSizeInput - haMinSizeInput) * t))

//@function Price of a footprint row's centre (the traded price with 1 tick per row).
haRowPrice(EstRow vr) =>
    vr.down_price() + (vr.up_price() - vr.down_price() - tick) / 2

var float haMaxVol = 0.0

haNewMarker(int side, float price, float v, float haThr) =>
    color c = side > 0 ? haBullInput : haBearInput
    float vmax = math.max(haMaxVol, v)
    int sz = haCircleSize(v, haThr, vmax)
    label lc = label.new(bar_index, price, "●", style = label.style_label_center, color = color.new(color.black, 100),
         textcolor = color.new(c, haFillTranspInput), size = sz)
    label lr = haRingInput ? label.new(bar_index, price, "○", style = label.style_label_center, color = color.new(color.black, 100),
         textcolor = color.new(c, math.max(0, haFillTranspInput - 45)), size = sz) : na
    label lt = label.new(bar_index, price, haVolText(v), style = label.style_label_center, color = color.new(color.black, 100),
         textcolor = haTextInput, size = haTextSizeInput, text_formatting = text.format_bold)
    haMarker.new(lc, lr, lt, bar_index, side, price, v, haThr)

// ───────────────────────────────────────────── detection on the current bar (live: every update)
float haMean = haTotN > 0 ? haTotS / haTotN : na
float haSd   = haTotN > 0 ? math.sqrt(math.max(0.0, haTotQ / haTotN - haMean * haMean)) : na
float haThr  = haMean + haKInput * haSd
bool  haReady = haTotN >= haMinSamplesInput

float haBestBuy = 0.0
float haBestBuyPx = na
float haBestSell = 0.0
float haBestSellPx = na
if haOn and (not na(fp))
    for vr in fp.rows()
        float b = vr.buy_volume()
        float s = vr.sell_volume()
        if b > haBestBuy
            haBestBuy   := b
            haBestBuyPx := haRowPrice(vr)
        if s > haBestSell
            haBestSell   := s
            haBestSellPx := haRowPrice(vr)
float haBN = (haBestBuy > 0 ? 1 : 0) + (haBestSell > 0 ? 1 : 0)
float haBS = haBestBuy + haBestSell
float haBQ = haBestBuy * haBestBuy + haBestSell * haBestSell

string haAlertMsg = ""
if haOn and (haReady and not na(fp))
    // strictly above the mean: a window of identical volumes (sd = 0) marks nothing
    if haSideInput != "Sellers only" and haBestBuy >= haThr and haBestBuy > haMean and haBestBuy >= haMinVolInput
        haMarkers.push(haNewMarker(1, haBestBuyPx, haBestBuy, haThr))
        haAlertMsg += "heavy BUY " + haVolText(haBestBuy) + " @ " + str.tostring(haBestBuyPx, format.mintick) + "  "
    if haSideInput != "Buyers only" and haBestSell >= haThr and haBestSell > haMean and haBestSell >= haMinVolInput
        haMarkers.push(haNewMarker(-1, haBestSellPx, haBestSell, haThr))
        haAlertMsg += "heavy SELL " + haVolText(haBestSell) + " @ " + str.tostring(haBestSellPx, format.mintick) + "  "

// ───────────────────────────────────────────── bar close: statistics, budget, alert
if haOn and (barstate.isconfirmed and not na(fp))
    haWN.push(haBN)
    haWS.push(haBS)
    haWQ.push(haBQ)
    haTotN += haBN
    haTotS += haBS
    haTotQ += haBQ
    while haWN.size() > haLookbackInput
        haTotN -= haWN.shift()
        haTotS -= haWS.shift()
        haTotQ -= haWQ.shift()
    for mk in haMarkers
        if mk.bar == bar_index
            haMaxVol := math.max(haMaxVol, mk.volume)
    while haMarkers.size() > haMaxMarkersInput
        haMarker old = haMarkers.shift()
        old.circle.delete()
        old.txt.delete()
        if not na(old.ring)
            old.ring.delete()
    if haAlertModeInput == "On bar close" and str.length(haAlertMsg) > 0
        alert(syminfo.ticker + " " + haAlertMsg, alert.freq_once_per_bar_close)

// live alert: the first update of a bar on which a buy (or sell) circle shows
varip int    haSentBar   = -1
varip string haSentSides = ""
if haOn and (haAlertModeInput == "Live (when a circle appears)" and str.length(haAlertMsg) > 0)
    if haSentBar != bar_index
        haSentBar   := bar_index
        haSentSides := ""
    string fresh = (str.contains(haAlertMsg, "BUY") and not str.contains(haSentSides, "B") ? "B" : "") +
         (str.contains(haAlertMsg, "SELL") and not str.contains(haSentSides, "S") ? "S" : "")
    if str.length(fresh) > 0
        haSentSides += fresh
        alert(syminfo.ticker + " " + haAlertMsg, alert.freq_all)

// relative sizing: the biggest marker on the chart sets the scale (recomputed on the last bar only)
if haOn and (barstate.islast and haSizingInput == "Relative to markers" and haMarkers.size() > 0)
    float vmax = 0.0
    for mk in haMarkers
        vmax := math.max(vmax, mk.volume)
    for mk in haMarkers
        int sz = haCircleSize(mk.volume, mk.threshold, vmax)
        mk.circle.set_size(sz)
        if not na(mk.ring)
            mk.ring.set_size(sz)

// ═════════════════════════════════════════════ Pressure Toolkit (switch: ptkOn)
// ───────────────────────────────────────────── inputs
PTK_G_GEN = "Pressure Toolkit: General"
int    ptkLookbackInput  = input.int(50, "Lookback bars (statistics)", minval = 5, maxval = 2000, group = PTK_G_GEN)
int    ptkMaxLabelsInput = input.int(100, "Max markers on chart (labels)", minval = 20, maxval = 120, group = PTK_G_GEN)

PTK_G_BUB = "Pressure Toolkit: Pressure bubbles"
bool   ptkShowBubblesInput = input.bool(true, "Show bubbles", group = PTK_G_BUB)
float  ptkWeakKInput     = input.float(1.0, "Weak bubble (std dev)", minval = 0, step = 0.1, group = PTK_G_BUB,
     tooltip = "Compared with the heaviest aggressive price of the recent bars (mean + k std dev).")
float  ptkStrongKInput   = input.float(2.0, "Strong bubble (std dev)", minval = 0, step = 0.1, group = PTK_G_BUB)
float  ptkDominanceInput = input.float(1.5, "Dominance ratio vs opposite side", minval = 1, step = 0.1, group = PTK_G_BUB)
int    ptkMaxPerSideInput = input.int(2, "Max bubbles per bar and side", minval = 1, maxval = 10, group = PTK_G_BUB)
int    ptkBubbleMinInput = input.int(14, "Bubble size min (pt)", minval = 4, maxval = 100, group = PTK_G_BUB)
int    ptkBubbleMaxInput = input.int(30, "Bubble size max (pt)", minval = 4, maxval = 120, group = PTK_G_BUB)
int    ptkWeakTranspInput = input.int(72, "Weak bubble transparency %", minval = 0, maxval = 100, group = PTK_G_BUB)
int    ptkStrongTranspInput = input.int(28, "Strong bubble transparency %", minval = 0, maxval = 100, group = PTK_G_BUB)

PTK_G_BIG = "Pressure Toolkit: Big trades"
bool   ptkShowBigInput   = input.bool(true, "Show big trades", group = PTK_G_BIG)
float  ptkBigKInput      = input.float(3.0, "Big trade (std dev)", minval = 0, step = 0.1, group = PTK_G_BIG,
     tooltip = "A bubble whose price holds far more aggressive volume than the heaviest price of a normal bar (mean + k std dev of each bar's heaviest price). TradingView gives no individual trades to scripts.")
int    ptkBigSizeInput   = input.int(13, "Square size (pt)", minval = 4, maxval = 60, group = PTK_G_BIG)

PTK_G_ABS = "Pressure Toolkit: Absorption"
bool   ptkShowDotsInput  = input.bool(true, "Show absorption dots", group = PTK_G_ABS)
float  ptkAbsKInput      = input.float(1.0, "Wick level (std dev)", minval = 0, step = 0.1, group = PTK_G_ABS)
float  ptkEnhKInput      = input.float(2.5, "Enhanced (std dev)", minval = 0, step = 0.1, group = PTK_G_ABS)
float  ptkMinWickPctInput = input.float(15, "Min wick share of bar volume %", minval = 0, maxval = 100, group = PTK_G_ABS)
bool   ptkShowLinesInput = input.bool(true, "Show absorption lines", group = PTK_G_ABS)
bool   ptkLiveLinesInput = input.bool(true, "Show the forming bar's lines (live, dashed)", group = PTK_G_ABS)
int    ptkMaxLinesWickInput = input.int(8, "Max lines per wick", minval = 1, maxval = 30, group = PTK_G_ABS)
int    ptkLineTranspInput = input.int(20, "Line transparency %", minval = 0, maxval = 100, group = PTK_G_ABS)
int    ptkMaxLinesInput  = input.int(250, "Max lines on chart", minval = 10, maxval = 250, group = PTK_G_ABS)

PTK_G_PSY = "Pressure Toolkit: Psychological levels"
bool   ptkShowPsychInput = input.bool(true, "Show psychological levels", group = PTK_G_PSY)
float  ptkPsychStepInput = input.float(0, "Step (0 = auto, about 0.3% of price)", minval = 0, group = PTK_G_PSY)
int    ptkPsychEachInput = input.int(6, "Levels each side", minval = 1, maxval = 20, group = PTK_G_PSY)
int    ptkPsychMajorInput = input.int(4, "Major level every", minval = 1, group = PTK_G_PSY)
color  ptkPsychColorInput = input.color(color.new(color.gray, 55), "Level color", group = PTK_G_PSY)

PTK_G_COL = "Pressure Toolkit: Colors"
color  ptkBuyColorInput  = input.color(color.rgb(46, 160, 90), "Buy", group = PTK_G_COL)
color  ptkSellColorInput = input.color(color.rgb(214, 46, 58), "Sell", group = PTK_G_COL)
color  ptkDotBullInput   = input.color(color.rgb(50, 205, 50), "Dot below lower wick", group = PTK_G_COL)
color  ptkDotBearInput   = input.color(color.rgb(198, 40, 40), "Dot above upper wick", group = PTK_G_COL)
color  ptkTextColorInput = input.color(color.rgb(209, 212, 220), "Big trade text", group = PTK_G_COL)

PTK_G_ALR = "Pressure Toolkit: Alerts (create one alert with 'Any alert() function call')"
bool   ptkAlertBubbleInput = input.bool(false, "Strong bubbles", group = PTK_G_ALR)
bool   ptkAlertBigInput  = input.bool(false, "Big trades", group = PTK_G_ALR)
bool   ptkAlertDotInput  = input.bool(false, "Absorption dots", group = PTK_G_ALR)
bool   ptkAlertLineInput = input.bool(false, "Absorption line retest", group = PTK_G_ALR)
bool   ptkAlertPsychInput = input.bool(false, "Psychological level cross", group = PTK_G_ALR)

// ───────────────────────────────────────────── data and state

type ptkALine
    line  ln
    float price
    int   bar
    int   endBar = -1

var array<ptkALine> ptkLines = array.new<ptkALine>()
// rolling statistics of the total volume per price (absorption)
var array<float> ptkLN = array.new_float()
var array<float> ptkLS = array.new_float()
var array<float> ptkLQ = array.new_float()
// each closed bar's heaviest aggressive price (buy and sell side): the population for big trades
var array<float> ptkMN = array.new_float()
var array<float> ptkMS = array.new_float()
var array<float> ptkMQ = array.new_float()
var float ptkMTotN = 0.0
var float ptkMTotS = 0.0
var float ptkMTotQ = 0.0
var float ptkLTotN = 0.0
var float ptkLTotS = 0.0
var float ptkLTotQ = 0.0

//@function Volume label: 165, 1.2k, 3.4M; crypto volumes keep decimals (18.5, 2.35, 0.042).
ptkVolText(float v) =>
    float a = math.abs(v)
    a >= 1e9 ? str.tostring(v / 1e9, "#.#") + "B" :
     a >= 1e6 ? str.tostring(v / 1e6, a >= 1e7 ? "#" : "#.#") + "M" :
     a >= 1e4 ? str.tostring(v / 1e3, "#") + "k" :
     a >= 1e3 ? str.tostring(v / 1e3, "#.#") + "k" :
     a >= 100 ? str.tostring(math.round(v)) :
     a >= 10 ? str.tostring(v, "#.#") : a >= 1 ? str.tostring(v, "#.##") : str.tostring(v, "#.###")

ptkRowPrice(EstRow vr) =>
    vr.down_price() + (vr.up_price() - vr.down_price() - tick) / 2

float ptkLMean = ptkLTotN > 0 ? ptkLTotS / ptkLTotN : na
float ptkLSd   = ptkLTotN > 0 ? math.sqrt(math.max(0.0, ptkLTotQ / ptkLTotN - ptkLMean * ptkLMean)) : na
bool  ptkReady = ptkMTotN >= 20 and ptkLTotN >= 30
float ptkMMean = ptkMTotN > 0 ? ptkMTotS / ptkMTotN : na
float ptkMSd   = ptkMTotN > 0 ? math.sqrt(math.max(0.0, ptkMTotQ / ptkMTotN - ptkMMean * ptkMMean)) : na
float ptkWeakThr   = ptkMMean + ptkWeakKInput * ptkMSd
float ptkStrongThr = ptkMMean + ptkStrongKInput * ptkMSd
float ptkBigThr    = math.max(ptkMMean + ptkBigKInput * ptkMSd, ptkWeakThr)
float ptkWickThr   = ptkLMean + ptkAbsKInput * ptkLSd
float ptkEnhThr    = ptkLMean + ptkEnhKInput * ptkLSd

// markers of this script, oldest first (trimmed to the budget at each bar close)
var array<label> ptkMarks = array.new<label>()
//@function Records a marker label for the chart budget.
ptkKeep(label l) =>
    ptkMarks.push(l)
    l

ptkBubbleSize(float v) =>
    float t = math.sqrt(math.max(0.0, math.min(1.0, (v / math.max(ptkWeakThr, 1e-9) - 1) / 3)))
    int(math.round(ptkBubbleMinInput + (ptkBubbleMaxInput - ptkBubbleMinInput) * t))

string ptkAlertMsg = ""

// ───────────────────────────────────────────── signals of the current bar (live: every update)
if ptkOn and (not na(fp))
    array<EstRow> rows = fp.rows()
    int n = rows.size()
    float barTotal = fp.total_volume()
    if ptkReady and n > 0
        // bubbles: the heaviest qualifying prices per side
        array<float> bVol = array.new_float()
        array<float> bPx  = array.new_float()
        array<float> sVol = array.new_float()
        array<float> sPx  = array.new_float()
        for vr in rows
            float b = vr.buy_volume()
            float s = vr.sell_volume()
            if b >= ptkWeakThr and b > ptkMMean and b > s and b >= ptkDominanceInput * s
                bVol.push(b)
                bPx.push(ptkRowPrice(vr))
            if s >= ptkWeakThr and s > ptkMMean and s > b and s >= ptkDominanceInput * b
                sVol.push(s)
                sPx.push(ptkRowPrice(vr))
        for side = 0 to 1
            array<float> vols = side == 0 ? bVol : sVol
            array<float> pxs  = side == 0 ? bPx : sPx
            color c = side == 0 ? ptkBuyColorInput : ptkSellColorInput
            if vols.size() > 0
                array<int> idx = vols.sort_indices(order.descending)
                for k = 0 to math.min(ptkMaxPerSideInput, idx.size()) - 1
                    float v  = vols.get(idx.get(k))
                    float px = pxs.get(idx.get(k))
                    bool strong = v >= ptkStrongThr
                    if ptkShowBubblesInput
                        ptkKeep(label.new(bar_index, px, "●", style = label.style_label_center, color = color.new(color.black, 100),
                             textcolor = color.new(c, strong ? ptkStrongTranspInput : ptkWeakTranspInput), size = ptkBubbleSize(v)))
                    if strong
                        ptkAlertMsg += (side == 0 ? "strong buy bubble " : "strong sell bubble ") + str.tostring(px, format.mintick) + "  "
                    if ptkShowBigInput and k == 0 and v >= ptkBigThr
                        ptkKeep(label.new(bar_index, px, "□", style = label.style_label_center, color = color.new(color.black, 100),
                             textcolor = side == 0 ? color.rgb(120, 230, 120) : color.rgb(240, 110, 100), size = ptkBigSizeInput))
                        ptkKeep(label.new(bar_index, px, ptkVolText(v), style = side == 0 ? label.style_label_up : label.style_label_down,
                             color = color.new(color.black, 100), textcolor = ptkTextColorInput, size = 9))
                        ptkAlertMsg += "big " + (side == 0 ? "buy " : "sell ") + ptkVolText(v) + " @ " + str.tostring(px, format.mintick) + "  "
        // absorption: heavy volume traded in a wick (rows outside the body)
        float bodyTop = math.max(open, close)
        float bodyBot = math.min(open, close)
        for side = 0 to 1
            bool atHigh = side == 0
            float wickVol = 0.0
            float maxLevel = 0.0
            array<float> heavyPx  = array.new_float()
            array<float> heavyVol = array.new_float()
            for vr in rows
                bool inWick = atHigh ? vr.down_price() > bodyTop + tick * 0.5 : vr.up_price() - tick < bodyBot - tick * 0.5
                if inWick
                    float v = vr.total_volume()
                    wickVol  += v
                    maxLevel := math.max(maxLevel, v)
                    if v >= ptkWickThr
                        heavyPx.push(ptkRowPrice(vr))
                        heavyVol.push(v)
            bool dot = maxLevel >= ptkWickThr and maxLevel > ptkLMean and barTotal > 0 and wickVol / barTotal * 100 >= ptkMinWickPctInput
            if dot
                bool enhanced = maxLevel >= ptkEnhThr
                if ptkShowDotsInput
                    ptkKeep(label.new(bar_index, atHigh ? high : low, "", yloc = atHigh ? yloc.abovebar : yloc.belowbar, style = label.style_circle,
                         color = atHigh ? ptkDotBearInput : ptkDotBullInput, size = enhanced ? size.small : size.tiny))
                ptkAlertMsg += (enhanced ? "enhanced " : "") + "absorption dot " + (atHigh ? "above " : "below ") + str.tostring(atHigh ? high : low, format.mintick) + "  "
                // absorption lines from the heaviest wick prices: kept once the bar is final, dashed while it forms
                bool liveBar = ptkLiveLinesInput and barstate.islast and not barstate.isconfirmed
                if ptkShowLinesInput and (barstate.isconfirmed or liveBar) and heavyVol.size() > 0
                    array<int> idx = heavyVol.sort_indices(order.descending)
                    for k = 0 to math.min(ptkMaxLinesWickInput, idx.size()) - 1
                        float px = heavyPx.get(idx.get(k))
                        // aggressor that was absorbed: buyers at an upper wick (green), sellers at a lower wick (red)
                        color c = atHigh ? ptkBuyColorInput : ptkSellColorInput
                        line l = line.new(bar_index, px, bar_index + 1, px, color = color.new(c, ptkLineTranspInput), width = 1,
                             style = barstate.isconfirmed ? line.style_solid : line.style_dashed)
                        if barstate.isconfirmed
                            ptkLines.push(ptkALine.new(l, px, bar_index, -1))

// ───────────────────────────────────────────── absorption lines: extend until price returns (gap aware)
float ptkHiR = math.max(high, nz(close[1], high))
float ptkLoR = math.min(low, nz(close[1], low))
if ptkOn
    for al in ptkLines
        if al.endBar < 0 and bar_index > al.bar
            if al.price >= ptkLoR - tick * 0.25 and al.price <= ptkHiR + tick * 0.25
                al.endBar := bar_index
                al.ln.set_x2(bar_index)
                ptkAlertMsg += "absorption line retest " + str.tostring(al.price, format.mintick) + "  "
            else
                al.ln.set_x2(bar_index + 1)
if ptkOn and (barstate.isconfirmed)
    while ptkMarks.size() > ptkMaxLabelsInput
        ptkMarks.shift().delete()
    while ptkLines.size() > ptkMaxLinesInput
        int drop = 0
        for [k, al] in ptkLines
            if al.endBar >= 0
                drop := k
                break
        ptkLines.remove(drop).ln.delete()

// ───────────────────────────────────────────── psychological levels
ptkPsychStep(float price) =>
    float result = ptkPsychStepInput
    if result <= 0 and price > 0
        float target = price * 0.003
        float mag = math.pow(10, math.floor(math.log10(target)))
        result := 0
        for m in array.from(1.0, 2.5, 5.0, 10.0, 25.0, 50.0, 100.0)
            float st = mag * m
            float ticks = st / tick
            if st >= target * 0.75 and ticks >= 1 - 1e-9 and math.abs(ticks - math.round(ticks)) < 1e-6
                result := math.round(ticks) * tick
                break
        if result <= 0
            result := math.max(1, math.ceil(target / tick - 1e-9)) * tick
    result

var array<line> ptkPsychLines = array.new<line>()
float ptkPStep = ptkPsychStep(close)
if ptkOn and (ptkShowPsychInput and barstate.islast and ptkPStep > 0)
    for l in ptkPsychLines
        l.delete()
    ptkPsychLines.clear()
    int base = int(math.floor(close / ptkPStep))
    for k = -ptkPsychEachInput + 1 to ptkPsychEachInput
        int lvl = base + k
        bool major = lvl % ptkPsychMajorInput == 0
        ptkPsychLines.push(line.new(bar_index - 1, lvl * ptkPStep, bar_index, lvl * ptkPStep, extend = extend.both,
             color = ptkPsychColorInput, width = major ? 2 : 1, style = major ? line.style_solid : line.style_dotted))
if ptkOn and (ptkAlertPsychInput and ptkPStep > 0 and not na(close[1]) and math.floor(close / ptkPStep) != math.floor(close[1] / ptkPStep))
    ptkAlertMsg += "crossed psychological level " + str.tostring(math.max(math.floor(close / ptkPStep), math.floor(close[1] / ptkPStep)) * ptkPStep, format.mintick) + "  "

// ───────────────────────────────────────────── bar close: statistics of the bar join the window
if ptkOn and (barstate.isconfirmed and not na(fp))
    float n2 = 0.0
    float s2 = 0.0
    float q2 = 0.0
    float maxB = 0.0
    float maxS = 0.0
    for vr in fp.rows()
        float b = vr.buy_volume()
        float s = vr.sell_volume()
        float t = vr.total_volume()
        if t > 0
            n2 += 1
            s2 += t
            q2 += t * t
        maxB := math.max(maxB, b)
        maxS := math.max(maxS, s)
    float n3 = (maxB > 0 ? 1 : 0) + (maxS > 0 ? 1 : 0)
    ptkMN.push(n3)
    ptkMS.push(maxB + maxS)
    ptkMQ.push(maxB * maxB + maxS * maxS)
    ptkMTotN += n3
    ptkMTotS += maxB + maxS
    ptkMTotQ += maxB * maxB + maxS * maxS
    while ptkMN.size() > ptkLookbackInput * 2
        ptkMTotN -= ptkMN.shift()
        ptkMTotS -= ptkMS.shift()
        ptkMTotQ -= ptkMQ.shift()
    ptkLN.push(n2)
    ptkLS.push(s2)
    ptkLQ.push(q2)
    ptkLTotN += n2
    ptkLTotS += s2
    ptkLTotQ += q2
    while ptkLN.size() > ptkLookbackInput
        ptkLTotN -= ptkLN.shift()
        ptkLTotS -= ptkLS.shift()
        ptkLTotQ -= ptkLQ.shift()

// one alert per signal kind and bar (the kinds already sent this bar are skipped)
varip int    ptkSentBar   = -1
varip string ptkSentKinds = ""
bool ptkWantAlert = str.length(ptkAlertMsg) > 0 and (ptkAlertBubbleInput or ptkAlertBigInput or ptkAlertDotInput or ptkAlertLineInput or ptkAlertPsychInput)
if ptkOn and (ptkWantAlert)
    // only the kinds that are switched on
    string msg = ""
    if ptkAlertBubbleInput and str.contains(ptkAlertMsg, "bubble")
        msg += "bubble "
    if ptkAlertBigInput and str.contains(ptkAlertMsg, "big ")
        msg += "big-trade "
    if ptkAlertDotInput and str.contains(ptkAlertMsg, "dot")
        msg += "absorption-dot "
    if ptkAlertLineInput and str.contains(ptkAlertMsg, "retest")
        msg += "line-retest "
    if ptkAlertPsychInput and str.contains(ptkAlertMsg, "psychological")
        msg += "psych-cross "
    if ptkSentBar != bar_index
        ptkSentBar   := bar_index
        ptkSentKinds := ""
    string fresh = ""
    for k in str.split(msg, " ")
        if str.length(k) > 0 and not str.contains(ptkSentKinds, k + " ")
            fresh += k + " "
    if str.length(fresh) > 0
        ptkSentKinds += fresh
        alert(syminfo.ticker + " [" + fresh + "] " + ptkAlertMsg, alert.freq_all)

// ═════════════════════════════════════════════ status
var bool anyFp = false
if not na(fp)
    anyFp := true

// typical bar range of this chart, for the row size hint
float typRange = ta.sma(high - low, 100)

//@function A round price step near `px`: 1, 2, 2.5 or 5 times a power of ten.
niceRow(float px) =>
    float mag = math.pow(10, math.floor(math.log10(px)))
    float f   = px / mag
    (f < 1.5 ? 1.0 : f < 2.25 ? 2.0 : f < 3.5 ? 2.5 : f < 7.5 ? 5.0 : 10.0) * mag

//@function Status text when the row size does not suit the chart, "" when it does. `fine`: also hint when the rows are
// much finer or coarser than about 20 per typical bar.
rowHint(string name, int used, bool fine) =>
    int sug = math.max(1, int(math.round(niceRow(typRange / 20) / syminfo.mintick)))
    not anyFp and typRange / (used * syminfo.mintick) > 1000 ? name + ": too many price rows per bar - set 'Ticks per row' to " + str.tostring(sug) :
         anyFp and fine and (used >= sug * 4 or sug >= used * 4) ? name + ": rows look too " + (used > sug ? "coarse" : "fine") + " for this chart - try 'Ticks per row' = " + str.tostring(sug) + " (now " + str.tostring(used) + ")" : ""

var table info = table.new(position.top_right, 1, 1)
if barstate.islast
    string hint = rowHint("IDC Order Flow Lite", rowTicks, imbOn or haOn or ptkOn)
    string msg  = not anyFp ? (str.length(hint) > 0 ? hint : "IDC Order Flow Lite: no volume data on this symbol") :
         hvnOn and hvnTfTooHigh ? "IDC HVN: choose a profile timeframe higher than the chart timeframe" :
         haOn and not haReady ? "IDC Heavy Absorption: collecting statistics (" + str.tostring(haTotN) + "/" + str.tostring(haMinSamplesInput) + ")" :
         ptkOn and not ptkReady ? "IDC Pressure Toolkit: collecting statistics" : hint
    table.cell(info, 0, 0, msg, text_color = color.orange, text_size = 9, tooltip = "Ticks per row: " + str.tostring(rowTicks))
